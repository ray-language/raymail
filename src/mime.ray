// raymail — MIME message construction: multipart bodies and base64
// attachments. The strict-rules encodings (RFC 2047 encoded-words, header
// folding at 78, base64 at 76, dot-stuffing) come from net/mail, which grew
// out of this app's hand-rolled versions.
import std/fs;
import std/time;
import std/crypto;
import std/hex;
import net/mail;

pub struct Attachment {
    filename: string,
    content: bytes,
}

pub struct Mail {
    from_addr: string,
    to_addrs: [string],
    subject: string,
    body: string,
    attachments: [Attachment],
}

fn boundary() -> string {
    "raymail-" + hex.hex_encode(crypto.random_bytes(12))
}

pub fn message_id(domain: string) -> string {
    "<" + hex.hex_encode(crypto.random_bytes(8)) + "@" + domain + ">"
}

fn domain_of(addr: string) -> string {
    match (addr.index_of("@")) {
        Option.Some(i) => addr.substring(i + 1, addr.len()),
        Option.None => "localhost",
    }
}

// The full RFC 5322 message (headers + body), WITHOUT dot-stuffing (that is
// applied at SMTP DATA time, see `smtp_data`).
pub fn render(m: Mail) -> string {
    var out = "";
    out = out + mail.header("From", m.from_addr);
    out = out + mail.header("To", join(m.to_addrs, ", "));
    out = out + mail.header("Subject", m.subject);
    out = out + mail.header("Date", time.to_rfc1123(time.now_utc()));
    out = out + mail.header("Message-ID", message_id(domain_of(m.from_addr)));
    out = out + mail.header("MIME-Version", "1.0");
    if (m.attachments.len() == 0) {
        out = out + mail.header("Content-Type", "text/plain; charset=utf-8");
        out = out + mail.header("Content-Transfer-Encoding", "8bit");
        out = out + "\r\n" + m.body;
        return out;
    }
    let b = boundary();
    out = out + mail.header("Content-Type", "multipart/mixed; boundary=\"" + b + "\"");
    out = out + "\r\n";
    out = out + "--" + b + "\r\n";
    out = out + "Content-Type: text/plain; charset=utf-8\r\n";
    out = out + "Content-Transfer-Encoding: 8bit\r\n\r\n";
    out = out + m.body + "\r\n";
    for a in m.attachments {
        out = out + "--" + b + "\r\n";
        out = out + "Content-Type: application/octet-stream; name=\"" + a.filename + "\"\r\n";
        out = out + "Content-Transfer-Encoding: base64\r\n";
        out = out + "Content-Disposition: attachment; filename=\"" + a.filename + "\"\r\n\r\n";
        out = out + mail.base64_body(a.content);
    }
    out + "--" + b + "--\r\n"
}

// The SMTP DATA payload: the rendered message dot-stuffed (CRLF line endings),
// always ending in CRLF so the ".\r\n" terminator sits on its own line.
pub fn smtp_data(m: Mail) -> string {
    var data = mail.dot_stuff(render(m));
    if (!data.ends_with("\r\n")) {
        data = data + "\r\n";
    }
    data + ".\r\n"
}

pub fn load_attachment(path: string) -> Result<Attachment, string> {
    let content = fs.read_file_bytes(path)?;
    var name = path;
    for part in path.split("/") {
        if (part != "") {
            name = part;
        }
    }
    Result.Ok(Attachment { filename: name, content: content })
}
