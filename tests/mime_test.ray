// MIME construction: the rendered message carries folded headers, RFC 2047
// subjects, base64 lines of 76 and a dot-stuffed SMTP DATA payload.
import mime;

fn plain(subject: string, to_addrs: [string], body: string) -> mime.Mail {
    mime.Mail {
        from_addr: "ana@example.com",
        to_addrs: to_addrs,
        subject: subject,
        body: body,
        attachments: []
    }
}

// The header block of a rendered message, one entry per physical line.
fn header_lines(msg: string) -> [string] {
    match (msg.index_of("\r\n\r\n")) {
        Option.Some(i) => msg.substring(0, i).split("\r\n"),
        Option.None => msg.split("\r\n"),
    }
}

@test
fn folds_long_headers_at_78() {
    var many: [string] = [];
    var i = 0;
    while (i < 12) {
        many.push("destinatario" + to_string(i) + "@example.com");
        i = i + 1;
    }
    let msg = mime.render(plain("hola", many, "x"));
    for line in header_lines(msg) {
        assert(line.len() <= 78);
    }
    assert(msg.contains("\r\n destinatario"));
    assert(msg.contains("Subject: hola\r\n"));
}

@test
fn non_ascii_subjects_become_encoded_words() {
    let plain_msg = mime.render(plain("plain subject", ["luis@example.com"], "x"));
    assert(plain_msg.contains("Subject: plain subject\r\n"));
    let msg = mime.render(plain("señales y ñandúes", ["luis@example.com"], "x"));
    assert(msg.contains("Subject: =?UTF-8?B?"));
    // A long non-ASCII subject is split into several encoded-words, each line
    // still within 78 columns (RFC 2047 caps a word at 75 characters).
    let long_msg = mime.render(plain("ñandú ".repeat(30), ["luis@example.com"], "x"));
    for line in header_lines(long_msg) {
        assert(line.len() <= 78);
    }
}

@test
fn base64_body_wraps_at_76() {
    var data: [int] = [];
    var i = 0;
    while (i < 200) {
        data.push(i);
        i = i + 1;
    }
    var m = plain("adjunto", ["luis@example.com"], "x");
    m.attachments = [mime.Attachment { filename: "d.bin", content: bytes_of(data) }];
    let msg = mime.render(m);
    for line in msg.split("\r\n") {
        assert(line.len() <= 78);
    }
    assert(msg.contains("AAECAwQF"));
}

@test
fn dot_stuffing_protects_lone_dots() {
    let data = mime.smtp_data(plain("s", ["luis@example.com"], "hola\n.\n.punto\nnormal"));
    assert(data.contains("\r\n..\r\n"));
    assert(data.contains("\r\n..punto\r\n"));
    // A body without a trailing newline still gets the terminator on its own line.
    assert(data.ends_with("\r\nnormal\r\n.\r\n"));
}

@test
fn multipart_render_carries_attachment() {
    let m = mime.Mail {
        from_addr: "ana@example.com",
        to_addrs: ["luis@example.com"],
        subject: "informe",
        body: "va adjunto",
        attachments: [mime.Attachment { filename: "datos.bin", content: b"\x00\x01\x02" }]
    };
    let msg = mime.render(m);
    assert(msg.contains("From: ana@example.com"));
    assert(msg.contains("multipart/mixed"));
    assert(msg.contains("filename=\"datos.bin\""));
    assert(msg.contains("Content-Transfer-Encoding: base64"));
    assert(msg.contains("AAEC"));
    // Closing boundary present.
    assert(msg.contains("--\r\n"));
}
